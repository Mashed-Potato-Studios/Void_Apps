# Void Cloud Monorepo Environment Variables Template
# Copy this file to .env or .env.local for local development

# Deployment & Remote Binding Configuration
VOID_REMOTE=0

# Database Configuration (Defaults to Void-managed D1 SQLite locally)
# For Postgres (when "database": "pg" in void.json):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/void_db

# Authentication Configuration (Better Auth)
AUTH_SECRET=development_auth_secret_must_be_at_least_32_characters_long
AUTH_EMAIL_FROM=noreply@void.app

# OAuth Providers (Set credentials as needed)
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Public API Configuration
PUBLIC_API_URL=http://localhost:5173
