{
  "name": "void-fingerprint",
  "version": "0.1.0",
  "private": false,
  "description": "Stable app fingerprint (manifest + hash + CLI) for Void Cloud apps",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "void-fingerprint": "./bin/void-fingerprint.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@void-monorepo/config": "workspace:*",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  }
}
