{
  "name": "void-fingerprint",
  "version": "0.1.0",
  "private": false,
  "description": "Stable app fingerprint (manifest + hash + CLI) for Void Cloud apps",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "void-fingerprint": "bin/void-fingerprint.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/assert-dts.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-concurrency=1 --import ./test/hooks/register.mjs \"test/**/*.test.ts\"",
    "preversion": "pnpm run build && pnpm run test",
    "release:dry": "pnpm run build && npm pack --dry-run",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "vite": "^6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "@void-monorepo/config": "workspace:*",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  }
}
