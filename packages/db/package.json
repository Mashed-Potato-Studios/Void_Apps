{
  "name": "@void-monorepo/db",
  "version": "0.1.0",
  "private": true,
  "description": "Centralized database schemas, migrations, and seeds for Void Cloud applications",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./seed": "./src/seed.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@void-monorepo/flow": "workspace:*",
    "@void-monorepo/types": "workspace:*",
    "drizzle-orm": "^0.39.1"
  },
  "devDependencies": {
    "@void-monorepo/config": "workspace:*",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.7.3"
  },
  "type": "module"
}
