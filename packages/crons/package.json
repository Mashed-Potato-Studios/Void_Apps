{
  "name": "@void-monorepo/crons",
  "version": "0.1.0",
  "private": true,
  "description": "Cron job scanner, manifest, local trigger, activity store, and dev panel for Void Cloud crons/",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui/CronPanel.tsx",
    "./scan": "./src/scan.ts",
    "./manifest": "./src/manifest.ts",
    "./cli": "./src/cli.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "void-crons": "bin/void-crons.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-concurrency=1 --import ./test/hooks/register.mjs \"test/**/*.test.ts\"",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": "./dist/index.js",
      "./ui": "./dist/ui/CronPanel.js",
      "./scan": "./dist/scan.js",
      "./manifest": "./dist/manifest.js",
      "./schedule": "./dist/schedule.js",
      "./cli": "./dist/cli.js",
      "./package.json": "./package.json"
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@void-monorepo/config": "workspace:*",
    "@void-monorepo/types": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "cron-parser": "^5"
  }
}
