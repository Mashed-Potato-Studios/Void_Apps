{
  "name": "void-crons",
  "version": "0.4.0",
  "description": "Cron job scanner, manifest, local trigger, activity store, TUI, and Worker-safe runtime adapters for Void Cloud crons/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mashed-Potato-Studios/Void_Apps.git",
    "directory": "packages/crons"
  },
  "homepage": "https://github.com/Mashed-Potato-Studios/Void_Apps/tree/main/packages/crons#readme",
  "bugs": {
    "url": "https://github.com/Mashed-Potato-Studios/Void_Apps/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui/CronPanel.tsx",
    "./scan": "./src/scan.ts",
    "./manifest": "./src/manifest.ts",
    "./schedule": "./src/schedule.ts",
    "./types": "./src/types.ts",
    "./runtime": "./src/runtime.ts",
    "./cli": "./src/cli.ts",
    "./tui": "./src/tui/run.ts",
    "./package.json": "./package.json",
    "./d1": "./src/d1.ts",
    "./queue": "./src/queue.ts",
    "./durable": "./src/durable.ts",
    "./live": "./src/live.ts",
    "./evidence": "./src/evidence.ts",
    "./production": "./src/production.ts"
  },
  "bin": {
    "void-crons": "bin/void-crons.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-concurrency=1 --import ./test/hooks/register.mjs \"test/**/*.test.ts\"",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": "./dist/index.js",
      "./ui": "./dist/ui/CronPanel.js",
      "./scan": "./dist/scan.js",
      "./manifest": "./dist/manifest.js",
      "./types": "./dist/types.js",
      "./runtime": "./dist/runtime.js",
      "./schedule": "./dist/schedule.js",
      "./cli": "./dist/cli.js",
      "./tui": "./dist/tui/run.js",
      "./package.json": "./package.json",
      "./d1": "./dist/d1.js",
      "./queue": "./dist/queue.js",
      "./durable": "./dist/durable.js",
      "./live": "./dist/live.js",
      "./evidence": "./dist/evidence.js",
      "./production": "./dist/production.js"
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@void-monorepo/config": "workspace:*",
    "@void-monorepo/types": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "cron-parser": "^5",
    "typescript": "^5.7.3"
  }
}
